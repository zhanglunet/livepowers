{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "handoff-v1",
  "type": "object",
  "required": ["schema", "task_id", "from", "to", "input", "expect"],
  "properties": {
    "schema": { "const": "handoff-v1" },
    "task_id": { "type": "string", "pattern": "^hb_[a-z0-9_-]+$" },
    "from": { "enum": ["main", "explore", "implement", "verify"] },
    "to": { "enum": ["main", "explore", "implement", "verify"] },
    "input": {
      "type": "object",
      "required": ["spec", "constraints"],
      "properties": {
        "spec": { "type": "string", "minLength": 1 },
        "files": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "expect": {
      "type": "object",
      "required": ["artifacts", "acceptance"],
      "properties": {
        "artifacts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "result": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["done", "blocked", "rejected"] },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  }
}
